<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.PostgresClient</AssemblyName>
    <RootNamespace>CodeBrix.PostgresClient</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The wire-protocol buffers, converters and SCRAM/GSS code use pointer and stackalloc
         code, as upstream does (upstream set this repository-wide). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keeps the trimming / NativeAOT analyzers on, so the library stays trim- and AOT-safe
         exactly as upstream ships it. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- DELIBERATE, NARROW EXCEPTION to the family "no NoWarn anywhere" rule, following the
         CodeBrix.Redis precedent (approved there 2026-09-01). NPG9001 / NPG9002 / NPG9003 are
         NOT analyzer defect rules: they are the diagnostic IDs of this library's own
         [Experimental] API gates (PgSqlDiagnostics.cs - converters, database info, DbType
         resolvers). C# raises an [Experimental] diagnostic as an ERROR even inside the declaring
         assembly, and the only sanctioned opt-ins are NoWarn or marking every internal caller
         [Experimental] too. This line is that opt-in acknowledgement - exactly what upstream's
         own csproj carries - and it suppresses no defect: every [Experimental] attribute is still
         present, so a CONSUMER of this package still sees the identical gate. NOTHING ELSE MAY
         EVER BE ADDED TO THIS LINE. -->
    <NoWarn>$(NoWarn);NPG9001;NPG9002;NPG9003</NoWarn>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.PostgresClient.PostgreSqlLicenseForever</PackageId>
    <Product>CodeBrix.PostgresClient</Product>
    <Title>CodeBrix.PostgresClient</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A fully managed ADO.NET data provider for PostgreSQL, with connection pooling, multi-host failover and load balancing, binary COPY import and export, logical and physical replication, notifications, and rich PostgreSQL type mapping. Includes PgSqlMapper, a built-in lightweight object mapper for running queries and commands directly against a connection.</Description>
    <PackageLicenseExpression>PostgreSQL</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.PostgresClient</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.PostgresClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2002-2026, Npgsql. Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>postgresql;postgres;pgsql;ado.net;database;sql;data-provider;micro-orm;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time source generator (see that project's header). ReferenceOutputAssembly=false:
         it is a compiler plug-in here, not a runtime dependency, and it is not packed. -->
    <ProjectReference Include="..\CodeBrix.PostgresClient.SourceGenerators\CodeBrix.PostgresClient.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
